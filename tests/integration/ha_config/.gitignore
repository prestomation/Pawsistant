# Home Assistant runtime artifacts, generated when the container runs locally
# (e.g. via ci/e2e-up.sh). Only the seeded fixtures below are tracked.
*.log
*.log.*
.HA_VERSION
.ha_run.lock
blueprints/
tts/
deps/

# Ignore all generated .storage entries except the seeded fixtures.
.storage/*
!.storage/pawsistant
!.storage/pawsistant_events_2025
!.storage/core.config_entries
# The e2e dashboard, seeded the way HA writes it when a user creates one via
# Settings -> Dashboards (replaces the old configuration.yaml lovelace block).
!.storage/lovelace_dashboards
!.storage/lovelace.pawsistant_e2e
