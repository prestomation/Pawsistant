# The oldest Home Assistant that Pawsistant supports. This is the only place that
# names it. CI tests it on every PR. hacs.json and the README badge must match it
# (tests/unit/test_oldest_ha.py checks that).
#
# To drop an old version: change these lines, hacs.json and the README badge, and
# add a CHANGELOG entry. To find the matching test package for a new version, read
# the "homeassistant==" pin of pytest-homeassistant-custom-component on PyPI.
OLDEST_HA=2025.1.4
OLDEST_HA_MIN=2025.1.0
OLDEST_PHCC=0.13.205
OLDEST_PYTHON=3.12
